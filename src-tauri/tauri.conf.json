{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asmart-autofill",
  "version": "0.1.0",
  "identifier": "com.asmart.autofill",
  "build": {
    "frontendDist": "placeholder-ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "asmart-autofill",
        "width": 420,
        "height": 560,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
