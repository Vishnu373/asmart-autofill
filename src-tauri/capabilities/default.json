{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-pairing-info",
    "allow-list-waiting",
    "allow-get-submission",
    "allow-mark-entered",
    "allow-delete-submissions",
    "clipboard-manager:allow-write-text",
    "updater:default"
  ]
}
